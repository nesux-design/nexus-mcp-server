# DO NOT put real secrets in GitHub.
# Copy this file locally to .dev.vars and fill values only in your local environment.
# For deployed Cloudflare Workers, use `wrangler secret put` instead.

# Cloudflare OAuth
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=

# Vercel OAuth
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=

# Netlify OAuth
NETLIFY_CLIENT_ID=
NETLIFY_CLIENT_SECRET=

# Sentry OAuth
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=

# Atlassian OAuth
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Airtable PAT (keep secret)
AIRTABLE_PAT=

# Supabase hosted MCP
SUPABASE_PROJECT_REF=dexsatutwvyxjerlorbd
# Supabase access/refresh tokens belong in TOKENS_KV, never in source control.

# Shared secret used by Nexus A1 to authenticate calls to this private gateway.
# The A1 service must send:
#   X-Nexus-User-Id: <stable-user-id>
#   X-Nexus-Signature: HMAC-SHA256(NEXUS_INTERNAL_AUTH_SECRET, user-id)
NEXUS_INTERNAL_AUTH_SECRET=
