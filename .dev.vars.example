# DO NOT put real secrets in GitHub.
# Copy this file locally to .dev.vars and fill values only in your local environment.
# For deployed Cloudflare Workers, use `wrangler secret put` instead.

# Cloudflare OAuth -> Cloudflare API MCP
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=

# Atlassian OAuth -> Atlassian Rovo MCP
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Sentry OAuth integration (not an MCP upstream in this gateway)
SENTRY_CLIENT_ID=
SENTRY_CLIENT_SECRET=

# Google OAuth integration (separate from Developer Knowledge MCP)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Developer Knowledge MCP
DEVELOPERKNOWLEDGE_API_KEY=

# Airtable MCP
AIRTABLE_PAT=

# Supabase hosted MCP is authenticated by Supabase's own MCP OAuth flow.
SUPABASE_PROJECT_REF=

# Shared secret used by the real NEXUS AI backend to authenticate calls to this private gateway.
# The A1 service must send:
#   X-Nexus-User-Id: <stable-user-id>
#   X-Nexus-Signature: HMAC-SHA256(NEXUS_INTERNAL_AUTH_SECRET, user-id)
NEXUS_INTERNAL_AUTH_SECRET=

# AES-GCM key material for OAuth/MCP tokens at rest.
# If omitted, NEXUS_INTERNAL_AUTH_SECRET is used as the derivation secret.
# Prefer a separate random secret in production.
NEXUS_TOKEN_ENCRYPTION_SECRET=
